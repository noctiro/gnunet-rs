  "reference_discrepancies": [
    {
      "id": "statistics.watch.persistence-bit",
      "state": "observed_normal_c",
      "source": "statistics_api.c:handle_statistics_watch_value vs gnunet-service-statistics.c:notify_change",
      "decision": "Retain server bit2 and raw flags; do not rewrite the official wire to match the C-client high-UID-bit mistake.",
      "runtime_proof_required": true
    },
    {
      "id": "statistics.watch.reconnect-hole",
      "state": "observed_normal_c",
      "source": "statistics_api.c:watch_cancel,try_connect,handle_statistics_watch_value",
      "decision": "Separate stable logical watch identity from fresh per-connection WIDs. Normal C public-owner traces observe suppression of a new WID0 watch and misrouting of WID1 into the old logical slot; current-source regression evidence remains required.",
      "runtime_proof_required": true
    },
    {
      "id": "statistics.client.missing-hostname",
      "state": "observed_normal_c_safety_error",
      "source": "src/lib/util/client.c:GNUNET_CLIENT_connect",
      "decision": "A valid Unix endpoint remains usable without a TCP hostname; Rust must not reproduce the normal C NULL-hostname dereference. Preserve source-bound negative reference evidence without treating the crash as a required Rust behavior.",
      "runtime_proof_required": true
    },
    {
      "id": "statistics.watch.pre-mq-notification",
      "state": "observed_normal_c_invalid_peer_acceptance",
      "source": "statistics_api.c:GNUNET_STATISTICS_watch,handle_statistics_watch_value",
      "decision": "Normal C accepts a WID for a queued logical watch even before its WATCH MQ envelope exists. Rust requires connection-local WID assignment at actual MQ admission before delivering a callback; this is an explicit protocol/ownership boundary, not a memory-safety necessity. Valid service interaction remains covered separately.",
      "runtime_proof_required": true
    },
    {
      "id": "statistics.disconnect.pre-write-confirm",
      "state": "observed_normal_c_invalid_peer_acceptance",
      "source": "statistics_api.c:handle_disconnect_confirm,statistics_transmit",
      "decision": "Normal C accepts confirmation once its disconnect envelope enters the MQ, even if earlier data remains physically unwritten. Rust requires the original barrier frame to be fully written before reporting ProcessingConfirmed. This preserves result integrity and is an explicit stricter invalid-peer policy, not a claim of identical C error acceptance or a memory-safety necessity.",
      "runtime_proof_required": true
    },
    {
      "id": "statistics.setter.int64-min",
      "state": "source_confirmed_undefined_C_boundary",
      "source": "statistics_api.c:add_setter_action and gnunet-service-statistics.c:handle_set",
      "decision": "Use defined unsigned_abs magnitude; retain compiler-profile differential cases without claiming ISO-C UB portability.",
      "runtime_proof_required": true
    },
    {
      "id": "statistics.disconnect.persistence",
      "state": "source_confirmed",
      "source": "statistics_api.c:handle_disconnect_confirm comment vs service handle_disconnect/save",
      "decision": "Confirmation is processing, never independently verified filesystem durability.",
      "runtime_proof_required": true
    }
  ],
