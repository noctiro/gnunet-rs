[workspace]
members=["crypto","host"]
[package]
name="gnunet-tcp-communicator-core"
version="0.1.0"
edition="2024"
rust-version="1.99.1"
license="MPL-2.0"
[features]
default=[]
[dependencies]
gnunet-types={path="@REPOSITORY@/crates/gnunet-types",default-features=false}
gnunet-wire={path="@REPOSITORY@/crates/gnunet-wire",default-features=false}
gnunet-crypto={path="@REPOSITORY@/crates/gnunet-crypto",default-features=false}
gnunet-session-crypto={path="crypto",default-features=false}
zeroize = { version = "=1.9.1", default-features = false, features = ["derive"] }
subtle = { version = "=2.6.1", default-features = false }
[lints.rust]
future_incompatible = { level = "deny", priority = -1 }
let_underscore_drop = "deny"
let_underscore_lock = "deny"
missing_docs = "deny"
non_ascii_idents = "deny"
unsafe_code = "deny"
unsafe_op_in_unsafe_fn = "deny"
unfulfilled_lint_expectations = "deny"
unused_must_use = "deny"
warnings = "deny"

[lints.clippy]
allow_attributes = "deny"
allow_attributes_without_reason = "deny"
await_holding_lock = "deny"
await_holding_refcell_ref = "deny"
dbg_macro = "deny"
expect_used = "deny"
exit = "deny"
let_underscore_future = "deny"
let_underscore_lock = "deny"
let_underscore_must_use = "deny"
let_unit_value = "deny"
mem_forget = "deny"
missing_safety_doc = "deny"
panic = "deny"
panic_in_result_fn = "deny"
print_stderr = "deny"
print_stdout = "deny"
redundant_clone = "deny"
todo = "deny"
undocumented_unsafe_blocks = "deny"
unimplemented = "deny"
unreachable = "deny"
unused_result_ok = "deny"
unwrap_used = "deny"

[lints.rustdoc]
broken_intra_doc_links = "deny"
invalid_html_tags = "deny"


[workspace.package]
version="0.1.0"
edition="2024"
rust-version="1.99.1"
license="MPL-2.0"
[workspace.lints.rust]
future_incompatible = { level = "deny", priority = -1 }
let_underscore_drop = "deny"
let_underscore_lock = "deny"
missing_docs = "deny"
non_ascii_idents = "deny"
unsafe_code = "deny"
unsafe_op_in_unsafe_fn = "deny"
unfulfilled_lint_expectations = "deny"
unused_must_use = "deny"
warnings = "deny"

[workspace.lints.clippy]
allow_attributes = "deny"
allow_attributes_without_reason = "deny"
await_holding_lock = "deny"
await_holding_refcell_ref = "deny"
dbg_macro = "deny"
expect_used = "deny"
exit = "deny"
let_underscore_future = "deny"
let_underscore_lock = "deny"
let_underscore_must_use = "deny"
let_unit_value = "deny"
mem_forget = "deny"
missing_safety_doc = "deny"
panic = "deny"
panic_in_result_fn = "deny"
print_stderr = "deny"
print_stdout = "deny"
redundant_clone = "deny"
todo = "deny"
undocumented_unsafe_blocks = "deny"
unimplemented = "deny"
unreachable = "deny"
unused_result_ok = "deny"
unwrap_used = "deny"

[workspace.lints.rustdoc]
broken_intra_doc_links = "deny"
invalid_html_tags = "deny"

[workspace.dependencies]
gnunet-crypto = {path="@REPOSITORY@/crates/gnunet-crypto",default-features=false}
gnunet-types = {path="@REPOSITORY@/crates/gnunet-types",default-features=false}
curve25519-dalek = { version = "=5.0.0", default-features = false, features = ["zeroize"] }
crypto-bigint = { version = "=0.7.9", default-features = false, features = ["zeroize"] }
sha2 = { version = "=0.11.1", default-features = false, features = ["zeroize"] }
zeroize = { version = "=1.9.1", default-features = false, features = ["derive"] }
subtle = { version = "=2.6.1", default-features = false }
chacha20 = { version = "=0.10.2", default-features = false, features = ["cipher", "zeroize"] }
cipher = { version = "=0.5.2", default-features = false, features = ["zeroize", "stream-wrapper"] }
aes = { version = "=0.9.3", default-features = false, features = ["zeroize"] }
ctr = { version = "=0.10.1", default-features = false, features = ["zeroize"] }
poly1305 = { version = "=0.9.1", default-features = false, features = ["zeroize"] }
ghash = { version = "=0.6.0", default-features = false, features = ["zeroize"] }
polyval = { version = "=0.7.3", default-features = false, features = ["zeroize", "hazmat"] }
