<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>CFBundleIdentifier</key><string>@BUNDLE_ID@</string>
  <key>CFBundleName</key><string>GNUnet DNS Proxy</string>
  <key>CFBundleExecutable</key><string>gnunet-dns-proxy</string>
  <key>CFBundlePackageType</key><string>SYSX</string>
  <key>CFBundleVersion</key><string>@BUNDLE_VERSION@</string>
  <key>CFBundleShortVersionString</key><string>@BUNDLE_VERSION@</string>
  <key>LSMinimumSystemVersion</key><string>15.0</string>
  <key>NSSystemExtensionUsageDescription</key>
  <string>GNUnet uses this extension to process DNS requests through the configured GNUnet DNS service.</string>
  <key>NetworkExtension</key>
  <dict>
    <key>NEMachServiceName</key><string>@APP_GROUP@.dns-proxy.@BUNDLE_VERSION@</string>
    <key>NEProviderClasses</key>
    <dict>
      <key>com.apple.networkextension.dns-proxy</key><string>GNUnetDNSProxyProvider</string>
    </dict>
  </dict>
</dict>
</plist>
