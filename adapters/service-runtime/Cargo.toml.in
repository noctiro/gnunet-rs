[package]
name = "gnunet-service-runtime"
version = "0.1.0"
edition = "2024"
rust-version = "1.99.1"
license = "MPL-2.0"

[workspace]

[dependencies]
gnunet-wire = { path = "@REPOSITORY@/crates/gnunet-wire", default-features = false }
zeroize = { version = "=1.9.1", default-features = false, features = ["alloc", "derive"] }
gnunet-config = { path = "@REPOSITORY@/adapters/config-std", default-features = false }
gnunet-types = { path = "@REPOSITORY@/crates/gnunet-types", default-features = false }
gnunet-crypto = { path = "@REPOSITORY@/crates/gnunet-crypto", default-features = false }
gnunet-native = { path = "@REPOSITORY@/adapters/native-std", default-features = false }
tokio = { version = "=1.54.1", default-features = false, features = ["rt", "net", "time", "signal", "io-util"] }
socket2 = { version = "=0.6.5", default-features = false }
libc = { version = "=0.2.191", default-features = false }
nix = { version = "=0.31.3", default-features = false, features = ["fs", "poll", "process", "user"] }

[lints.rust]
future_incompatible = { level = "deny", priority = -1 }
let_underscore_drop = "deny"
let_underscore_lock = "deny"
missing_docs = "deny"
non_ascii_idents = "deny"
unsafe_code = "deny"
unsafe_op_in_unsafe_fn = "deny"
unfulfilled_lint_expectations = "deny"
unused_must_use = "deny"
warnings = "deny"

[lints.clippy]
allow_attributes = "deny"
allow_attributes_without_reason = "deny"
await_holding_lock = "deny"
await_holding_refcell_ref = "deny"
dbg_macro = "deny"
expect_used = "deny"
exit = "deny"
let_underscore_future = "deny"
let_underscore_lock = "deny"
let_underscore_must_use = "deny"
let_unit_value = "deny"
mem_forget = "deny"
missing_safety_doc = "deny"
panic = "deny"
panic_in_result_fn = "deny"
print_stderr = "deny"
print_stdout = "deny"
redundant_clone = "deny"
todo = "deny"
undocumented_unsafe_blocks = "deny"
unimplemented = "deny"
unreachable = "deny"
unused_result_ok = "deny"
unwrap_used = "deny"

[lints.rustdoc]
broken_intra_doc_links = "deny"
invalid_html_tags = "deny"

