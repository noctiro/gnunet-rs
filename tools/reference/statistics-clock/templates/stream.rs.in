//! Finite OS return provider, not a protocol or client-state implementation.
#![allow(dead_code)]
use std::{
    collections::VecDeque,
    io,
    pin::Pin,
    sync::{Arc, Mutex},
    task::{Context, Poll},
};
use tokio::io::{AsyncRead, ReadBuf};
#[derive(Clone, Copy, Debug)]
pub(crate) enum Send {
    Bytes(usize),
    Error(io::ErrorKind),
}
#[derive(Default)]
pub(crate) struct State {
    pub(crate) sends: VecDeque<Send>,
    pub(crate) calls: Vec<Vec<u8>>,
    pub(crate) accepted: Vec<u8>,
    pub(crate) ready: bool,
    pub(crate) readiness_error: Option<io::ErrorKind>,
}
pub struct Stream(pub(crate) Arc<Mutex<State>>);
impl Stream {
    pub(crate) fn scripted(sends: impl IntoIterator<Item = Send>) -> (Self, Arc<Mutex<State>>) {
        let state = Arc::new(Mutex::new(State {
            sends: sends.into_iter().collect(),
            ready: true,
            ..State::default()
        }));
        (Self(state.clone()), state)
    }
    pub(crate) fn poll_write_ready(&self, _: &mut Context<'_>) -> Poll<io::Result<()>> {
        let mut state = self.0.lock().unwrap();
        if let Some(e) = state.readiness_error.take() {
            return Poll::Ready(Err(e.into()));
        }
        if state.ready {
            Poll::Ready(Ok(()))
        } else {
            Poll::Pending
        }
    }
    pub(crate) fn try_write(&self, bytes: &[u8]) -> io::Result<usize> {
        let mut state = self.0.lock().unwrap();
        state.calls.push(bytes.to_vec());
        match state
            .sends
            .pop_front()
            .expect("finite return script exhausted")
        {
            Send::Error(e) => Err(e.into()),
            Send::Bytes(n) => {
                assert!(n <= bytes.len());
                state.accepted.extend_from_slice(&bytes[..n]);
                Ok(n)
            }
        }
    }
}
impl AsyncRead for Stream {
    fn poll_read(
        self: Pin<&mut Self>,
        _: &mut Context<'_>,
        _: &mut ReadBuf<'_>,
    ) -> Poll<io::Result<()>> {
        Poll::Pending
    }
}
